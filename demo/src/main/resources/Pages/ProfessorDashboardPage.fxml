<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<VBox spacing="0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controllers.ProfessorDashboardController"
      prefHeight="800.0" prefWidth="1200.0"
      style="-fx-background-color: #f5fff6;">

    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 18; -fx-background-color: #2e7d32;">
        <Label text="Professor Dashboard"
               style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Social" onAction="#goToSocial"
                style="-fx-background-color: white; -fx-text-fill: #2e7d32; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16;" />
        <Button text="Logout" onAction="#handleLogout"
                style="-fx-background-color: #1b5e20; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16;" />
    </HBox>

    <HBox spacing="20" style="-fx-padding: 20;">
        <VBox spacing="20" HBox.hgrow="ALWAYS">
            <VBox spacing="10" style="-fx-background-color: white; -fx-padding: 28; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0.2, 0, 3);">
                <Label text="Welcome to your PCMS" style="-fx-font-size: 28px; -fx-font-weight: bold;" />
                <Label fx:id="emailLabel" text="professor@email.com" wrapText="true" style="-fx-font-size: 14px; -fx-text-fill: #666;" />
            </VBox>

            <VBox spacing="12" style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0.2, 0, 3);">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label text="Courses" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="+ Add Class" onAction="#goToAddCourse"
                            style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16;" />
                </HBox>
                <Separator />
                <ScrollPane fitToWidth="true" prefViewportHeight="470" style="-fx-background-color: transparent; -fx-background-insets: 0;">
                    <VBox fx:id="courseContainer" spacing="14" style="-fx-padding: 8;" />
                </ScrollPane>
            </VBox>
        </VBox>

        <VBox spacing="18" prefWidth="300" style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0.2, 0, 3);">
            <Circle radius="42.0" style="-fx-fill: #d9ead3;" />
            <Label text="Current Semester" style="-fx-font-size: 16px; -fx-text-fill: #666;" />
            <Label fx:id="semesterLabel" text="Fall 2026" style="-fx-font-size: 30px; -fx-font-weight: bold;" />
            <Separator />
            <Label text="Total Courses" style="-fx-font-size: 16px; -fx-text-fill: #666;" />
            <Label fx:id="totalCoursesLabel" text="0" style="-fx-font-size: 44px; -fx-font-weight: bold;" />
        </VBox>
    </HBox>
</VBox>
