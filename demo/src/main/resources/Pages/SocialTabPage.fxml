<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" xmlns:fx="http://javafx.com/fxml" fx:controller="Controllers.SocialTabController" prefHeight="800" prefWidth="1200" style="-fx-background-color: #f5fff6;">
    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-padding: 18; -fx-background-color: #2e7d32;">
        <Button text="← Dashboard" onAction="#goToDashboard" style="-fx-background-color: white; -fx-text-fill: #2e7d32; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16;" />
        <Label text="Department Social" style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" />
    </HBox>

    <HBox spacing="20" style="-fx-padding: 20;">
        <VBox spacing="15" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 22; -fx-background-radius: 18; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0.2, 0, 3);">
            <Label text="FSC PROUD" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;" />
            <Label text="Computer &amp; Information Systems Dept." style="-fx-font-size: 24px; -fx-font-weight: bold;" />
            <Separator />
            <ScrollPane fitToWidth="true" prefViewportHeight="470" style="-fx-background-color: transparent; -fx-background-insets: 0;">
                <VBox fx:id="feedContainer" spacing="10" style="-fx-padding: 8;" />
            </ScrollPane>
            <Separator />
            <HBox spacing="15" alignment="CENTER_LEFT">
                <TextArea fx:id="postInput" promptText="Write a department update..." prefHeight="80" HBox.hgrow="ALWAYS" wrapText="true" />
                <Button text="Post" onAction="#handlePost" prefWidth="120" prefHeight="50" style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 8;" />
            </HBox>
        </VBox>
    </HBox>
</VBox>
