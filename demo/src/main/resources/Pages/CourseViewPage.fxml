<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="Controllers.CourseViewController"
      style="-fx-background-color: #f5fff6;">


    <HBox alignment="CENTER_LEFT"
          spacing="15"
          style="-fx-padding: 18; -fx-background-color: #2e7d32;">

        <Button text="← Back"
                onAction="#goBackMouse"
                style="-fx-background-color: white;
                       -fx-text-fill: #2e7d32;
                       -fx-font-weight: bold;
                       -fx-padding: 8 16 8 16;
                       -fx-background-radius: 8;" />

        <Label text="Course Details"
               style="-fx-text-fill: white;
                      -fx-font-size: 22px;
                      -fx-font-weight: bold;" />
    </HBox>

    <!-- MAIN CONTENT AREA -->
    <HBox spacing="20" style="-fx-padding: 20;">

        <!-- LEFT SIDE -->
        <VBox spacing="20" HBox.hgrow="ALWAYS">

            <!-- COURSE INFO CARD -->
            <VBox spacing="12"
                  style="-fx-background-color: white;
                         -fx-padding: 28;
                         -fx-background-radius: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 12, 0.2, 0, 4);">

                <Label fx:id="courseNameLabel"
                       style="-fx-font-size: 26px; -fx-font-weight: bold;" />

                <Separator/>

                <Label fx:id="semesterLabel" />
                <Label fx:id="sectionLabel" />
                <Label fx:id="studentsLabel" />
                <Label fx:id="timeLabel" />
                <Label fx:id="roomLabel" />

                <Label fx:id="avgLabel"
                       style="-fx-font-size: 15px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #333;" />
            </VBox>


            <VBox spacing="12"
                  style="-fx-background-color: white;
                         -fx-padding: 22;
                         -fx-background-radius: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.12), 10, 0.2, 0, 3);">

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="Student Roster"
                           style="-fx-font-size: 18px;
                                  -fx-font-weight: bold;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="+ Add Student"
                            onAction="#addStudent"
                            style="-fx-background-color: #2e7d32;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 8;" />
                </HBox>

                <Separator/>

                <ScrollPane fitToWidth="true"
                            prefViewportHeight="350"
                            style="-fx-background-color: transparent; -fx-background-insets: 0;">

                    <VBox fx:id="courseContainer"
                          spacing="10"
                          style="-fx-padding: 8;" />

                </ScrollPane>

            </VBox>

        </VBox>


        <VBox spacing="12"
              prefWidth="260"
              style="-fx-background-color: white;
                     -fx-padding: 20;
                     -fx-background-radius: 15;
                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0.2, 0, 3);">

            <Label text="Grade Weights"
                   style="-fx-font-size: 16px;
                          -fx-font-weight: bold;" />


            <Label text="Enter as decimals (example: 0.20 = 20%)"
                   style="-fx-font-size: 12px;
                          -fx-text-fill: #666;" />

            <Label text="Quiz %" />
            <TextField fx:id="quizWeightField" />

            <Label text="Tests %" />
            <TextField fx:id="testWeightField" />

            <Label text="Assignments %" />
            <TextField fx:id="assignmentWeightField" />

            <Label text="Participation %" />
            <TextField fx:id="participationWeightField" />

            <Button text="Apply Weights"
                    onAction="#applyWeights"
                    style="-fx-background-color: #2e7d32;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;" />

        </VBox>

    </HBox>

</VBox>
